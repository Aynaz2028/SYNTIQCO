# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, used by the retention-alerts cron route to
# bypass RLS across all students. NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key (Google AI Studio). App runs with mock responses if unset.
GEMINI_API_KEY=

# Web Push VAPID keypair — generate with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:hello@habitfirst.app

# Shared secret the retention-alerts cron caller must send as:
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
